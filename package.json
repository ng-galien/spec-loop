{
  "name": "mcp-spec-loop",
  "version": "0.1.0",
  "description": "MCP server and skills for a software construction loop: a JSON feature model kept by an agent, projected into Markdown for the owner, with a human feedback loop.",
  "type": "module",
  "license": "MIT",
  "author": "Alexandre Boyer",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mcp-spec-loop": "dist/mcp.js"
  },
  "main": "dist/lib/index.js",
  "files": [
    "dist",
    "schema",
    "templates",
    "method",
    "skills"
  ],
  "scripts": {
    "assemble": "node scripts/assemble.mjs",
    "build": "node scripts/assemble.mjs && tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "start": "node dist/mcp.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "diff": "^9.0.0",
    "fast-json-patch": "^3.1.1",
    "handlebars": "^4.7.10",
    "happy-dom": "^20.14.6",
    "mermaid": "^12.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
